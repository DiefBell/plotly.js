{
    "compilerOptions": {
        "target": "ES2016",
        "lib": ["ES2016", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./dist/npm/types",
        "rootDir": "./src"
    },
    "include": [
        "src/globals.d.ts",
        "src/lib/**/*.ts",
        "src/registry.ts",
        "src/core.ts",
        "src/index.ts",
        "src/traces/scatter/**/*.ts",
        "src/traces/bar/**/*.ts",
        "src/traces/histogram/**/*.ts",
        "src/traces/histogram2d/**/*.ts",
        "src/traces/histogram2dcontour/**/*.ts",
        "src/traces/barpolar/**/*.ts",
        "src/traces/waterfall/**/*.ts",
        "src/traces/funnel/**/*.ts",
        "src/traces/funnelarea/**/*.ts",
        "src/traces/pie/**/*.ts",
        "src/traces/sunburst/**/*.ts",
        "src/traces/treemap/**/*.ts",
        "src/traces/icicle/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "build", "test", "lib"]
}
