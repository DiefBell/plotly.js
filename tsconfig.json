{
    "compilerOptions": {
        "target": "ES2016",
        "lib": ["ES2016", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./dist/npm/types",
        "rootDir": "./src"
    },
    "include": [
        "src/globals.d.ts",
        "src/lib/**/*.ts",
        "src/registry.ts",
        "src/core.ts",
        "src/index.ts",
        "src/types/**/*.ts",
        "src/plot_api/container_array_match.ts",
        "src/plot_api/edit_types.ts",
        "src/plot_api/helpers.ts",
        "src/plot_api/plot_config.ts",
        "src/plot_api/plot_template.ts",
        "src/plot_api/subroutines.ts",
        "src/plot_api/manage_arrays.ts",
        "src/plot_api/plot_schema.ts",
        "src/plot_api/validate.ts",
        "src/plot_api/template_api.ts",
        "src/traces/scatter/**/*.ts",
        "src/traces/bar/**/*.ts",
        "src/traces/histogram/**/*.ts",
        "src/traces/histogram2d/**/*.ts",
        "src/traces/histogram2dcontour/**/*.ts",
        "src/traces/barpolar/**/*.ts",
        "src/traces/waterfall/**/*.ts",
        "src/traces/funnel/**/*.ts",
        "src/traces/funnelarea/**/*.ts",
        "src/traces/pie/**/*.ts",
        "src/traces/sunburst/**/*.ts",
        "src/traces/treemap/**/*.ts",
        "src/traces/icicle/**/*.ts",
        "src/traces/box/**/*.ts",
        "src/traces/violin/**/*.ts",
        "src/traces/ohlc/**/*.ts",
        "src/traces/candlestick/**/*.ts",
        "src/traces/surface/**/*.ts",
        "src/traces/scatter3d/**/*.ts",
        "src/traces/mesh3d/**/*.ts",
        "src/traces/streamtube/**/*.ts",
        "src/traces/cone/**/*.ts",
        "src/traces/isosurface/**/*.ts",
        "src/traces/volume/**/*.ts",
        "src/traces/scattergeo/**/*.ts",
        "src/traces/choropleth/**/*.ts",
        "src/traces/scattermapbox/**/*.ts",
        "src/traces/scattermap/**/*.ts",
        "src/traces/choroplethmapbox/**/*.ts",
        "src/traces/choroplethmap/**/*.ts",
        "src/traces/densitymapbox/**/*.ts",
        "src/traces/densitymap/**/*.ts",
        "src/traces/carpet/**/*.ts",
        "src/traces/scattercarpet/**/*.ts",
        "src/traces/contourcarpet/**/*.ts",
        "src/traces/heatmap/**/*.ts",
        "src/traces/contour/**/*.ts",
        "src/traces/scattersmith/**/*.ts",
        "src/traces/scatterternary/**/*.ts",
        "src/traces/scatterpolar/**/*.ts",
        "src/traces/image/**/*.ts",
        "src/traces/indicator/**/*.ts",
        "src/traces/table/**/*.ts",
        "src/traces/sankey/**/*.ts",
        "src/traces/parcoords/**/*.ts",
        "src/traces/scattergl/**/*.ts",
        "src/traces/parcats/**/*.ts",
        "src/traces/splom/**/*.ts",
        "src/traces/scatterpolargl/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "build", "test", "lib"]
}
